# ==============================================================================
# AWS Cloud Cost Intelligence Platform Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=false
APP_NAME="AWS Cost Intelligence"
PRODUCT_NAME="cloud-cost-intelligence"

# Demo Mode (true: uses deterministic Mock AWS Provider; false: uses live AWS APIs)
DEMO_MODE=true

# Database Configuration (PostgreSQL by default; fallback to SQLite for local development)
DATABASE_URL=postgresql://finops:finops_password@localhost:5432/cloud_cost_db
# SQLite local alternative: sqlite:///./cloud_cost.db

# Security & Authentication
SECRET_KEY=change-this-to-a-super-secret-hex-encoded-32-byte-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google OAuth Single Sign-On (Optional - required for real Google Workspace login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# AWS Configuration (Used when DEMO_MODE=false)
# Prefer IAM Roles / STS AssumeRole over static credentials in production
AWS_DEFAULT_REGION=us-east-1
AWS_ROLE_ARN=arn:aws:iam::123456789012:role/FinOpsCostExplorerReadOnlyRole
AWS_ROLE_EXTERNAL_ID=finops-cost-intelligence-access-2026
# Static credentials (only if not using IAM Role / EC2 Instance Metadata / ECS Task Role)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Notification: Email (SMTP)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM="AWS Cost Intelligence <finops-alerts@example.com>"
EMAIL_RECIPIENTS="finops-team@example.com,cto@example.com"

# Notification: Slack Webhook
SLACK_WEBHOOK_URL=

# Notification: Google Chat Webhook
GCHAT_WEBHOOK_URL=

# Notification: Microsoft Teams Webhook
TEAMS_WEBHOOK_URL=

# Report Retention (in days; reports older than this will be automatically archived or purged)
REPORT_RETENTION_DAYS=90

# Report Storage Paths
REPORT_OUTPUT_DIR=backend/reports

